# Effusion Labs — Environment Configuration (Agentic Lens-First Edition)
# 2026-09-01T09:37-06:00
# NEVER hardcode secrets. Inject via env or runtime vault.

# GitHub PAT for autonomous agent operations (CI, swarm, competitive intel)
# Export before running: export GITHUB_TOKEN="ghp_..."
GITHUB_TOKEN=

# Ophel Vault — conversation memory and LanceDB local storage
OPHEL_VAULT_PATH=

# Modelbeats — dynamic model selection router
MODELBEATS_API_ENDPOINT=

# Zedra — remote agent control daemon
ZEDRA_DAEMON_HOST=localhost:17357

# Musepool — CDN-aware package resolution
MUSEPOOL_CDN_PRIMARY=alibaba

# MCP Transport mode (stdio | sse | http)
MCP_TRANSPORT=stdio

# Lens system — build-time analysis toggle
LENS_ENABLED=true
LENS_SWARM_CONCURRENCY=16
LENS_AUTO_COMMIT=false

# AST Engine Configuration
AST_ENGINE_ENABLED=true
AST_VISITOR_DIR=./lib/ast-visitors
AST_MAX_ANNOTATIONS_PER_FILE=50
AST_CIRCULAR_DEP_BLOCK=true

# Strata Debt Detection
STRATA_DEBT_THRESHOLD=40
STRATA_DEBT_BLOCK_CRITICAL=true

# Swarm Orchestrator Configuration
SWARM_MAX_CONCURRENCY=18
SWARM_TIMEOUT_MS=30000
SWARM_RETRY_COUNT=2

# Vector Pipeline
VECTOR_MODEL=fastembed
VECTOR_DIM=384
VECTOR_BATCH_SIZE=32

# WebSocket Sync
SYNC_PORT=17358

# Temporal Drift Detection
TEMPORAL_HISTORY_DIR=./.temporal-history
TEMPORAL_MAX_SNAPSHOTS=50
TEMPORAL_SIM_THRESHOLD=0.85

# Probabilistic Uncertainty
PROB_ITERATIONS=100
PROB_PERTURBATION=0.05
PROB_CONFIDENCE=0.95

# Federated Learning
FED_LR=0.01
FED_BATCH_SIZE=16
FED_ROUNDS=5
FED_MIN_NODES=3

# Consensus Engine
CONSENSUS_QUORUM=0.67
CONSENSUS_OUTLIER=2.0
CONSENSUS_MAX_DISSENT=3

# Self-Modification
SELF_MOD_STAGING=./.self-mod-staging
SELF_MOD_THRESHOLD=0.3
SELF_MOD_MAX_PATCHES=5

# Quantum Superposition
QUANTUM_DIMS=8
QUANTUM_BOOST=2.0
QUANTUM_COLLAPSE=0.7
