{
  "name": "effusion-labs",
  "version": "2.0.0",
  "description": "Effusion Labs — Digital studio and knowledge base. Bun-powered, modular, Eleventy + Vite + Tailwind v4.",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun @11ty/eleventy --serve --watch",
    "build": "bunx --bun @11ty/eleventy",
    "preview": "bunx --bun vite preview",
    "clean": "rm -rf .11ty-vite dist"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-navigation": "^1.0.0",
    "@11ty/eleventy-plugin-rss": "^2.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@11ty/eleventy-plugin-vite": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.2.0"
}
